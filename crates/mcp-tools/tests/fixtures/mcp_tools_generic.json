  {
    "name": "script_run",
    "description": "Run a read-only script in the sandbox; the user approves only the final result. Run every new or changed script with dry_run sparse and dry_run full first (no approval needed; results come from documented examples, meta.dry_run: true), then run it for real once. Default limits: heap_mb=256, max_call_result_mb=16, max_calls=200, max_concurrent_calls=4, max_fetch_mb=50, max_result_mb=16, process_mb=512, timeout_s=120; the effective limits for an instance: ops_describe with op_id and instance (field script_limits).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "args": {},
        "dry_run": {
          "enum": [
            "full",
            "sparse"
          ]
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "heap_mb": {
              "minimum": 1,
              "type": "integer"
            },
            "max_call_result_mb": {
              "minimum": 1,
              "type": "integer"
            },
            "max_calls": {
              "minimum": 1,
              "type": "integer"
            },
            "max_concurrent_calls": {
              "minimum": 1,
              "type": "integer"
            },
            "max_fetch_mb": {
              "minimum": 1,
              "type": "integer"
            },
            "max_result_mb": {
              "minimum": 1,
              "type": "integer"
            },
            "process_mb": {
              "minimum": 1,
              "type": "integer"
            },
            "timeout_s": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "reason": {
          "maxLength": 1000,
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "request_await",
    "description": "Wait for a request's decision (up to ATLAS_DUCK_MCP_TIMEOUT). Never resubmit a pending request.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^req_[A-Za-z0-9_-]{20,64}$",
          "type": "string"
        }
      },
      "required": [
