{
  "identifier": "settings",
  "description": "the Settings window (Δ1): settings, instances, credential trigger, CLI, removal",
  "windows": ["settings"],
  "permissions": [
    "allow-app-status",
    "allow-cli-install",
    "allow-cli-uninstall",
    "allow-credential-window-open",
    "allow-instance-accept-url-change",
    "allow-instance-add",
    "allow-instance-change-url",
    "allow-instance-confirm-config",
    "allow-instance-set-proxy",
    "allow-prune-backlog-now",
    "allow-removal-backup",
    "allow-removal-begin",
    "allow-removal-finish",
    "allow-removal-mark",
    "allow-removal-state",
    "allow-retest-token",
    "allow-settings-apply",
    "allow-settings-get",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
